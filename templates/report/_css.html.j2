<style>
:root {
  --bg: #ffffff;
  --bg-elev-1: #fafafa;
  --bg-elev-2: #f4f4f4;
  --border: #e4e4e4;
  --border-strong: #c8c8c8;
  --text-primary: #1a1a1a;
  --text-muted: #6e6e6e;
  --text-faint: #a8a8a8;
  --status-ok: #0f7a3d;
  --status-ok-bg: #e5f4eb;
  --status-warn: #b3631a;
  --status-warn-bg: #fbf0e2;
  --status-bad: #b3261e;
  --status-bad-bg: #f9e6e4;
  --status-busy: #2a6db3;
  --status-busy-bg: #e7f0fa;
  --code-bg: #f4f4f4;
  --space-0: 0;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-6: 24px;
  --space-8: 32px;
  --space-12: 48px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  font-size: 14px;
  line-height: 20px;
}

body {
  margin: 0;
  padding: var(--space-4);
  max-width: 1280px;
  color: var(--text-primary);
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

h1 {
  margin: 0 0 var(--space-2);
  font-size: 18px;
  line-height: 24px;
  font-weight: 600;
}

h2 {
  margin: var(--space-12) 0 var(--space-4);
  font-size: 15px;
  line-height: 22px;
  font-weight: 600;
}

h3.rejection-group-header {
  margin: var(--space-6) 0 var(--space-2);
  font-size: 13px;
  line-height: 18px;
  font-weight: 500;
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  color: var(--text-muted);
}

header,
main,
footer {
  display: block;
}

header {
  margin-bottom: var(--space-8);
  padding-bottom: var(--space-4);
  border-bottom: 1px solid var(--border);
}

.run-meta {
  margin: 0;
  color: var(--text-muted);
  font-size: 13px;
  line-height: 18px;
}

.run-meta span + span::before {
  content: " · ";
}

.banner {
  margin: var(--space-4) 0;
  padding: var(--space-3) var(--space-4);
  border: 1px solid var(--border);
  background: var(--bg-elev-1);
}

.banner-warn {
  border-color: var(--status-warn);
  background: var(--status-warn-bg);
  color: var(--status-warn);
}

.banner-busy {
  border-color: var(--status-busy);
  background: var(--status-busy-bg);
  color: var(--status-busy);
}

.banner-bad {
  border-color: var(--status-bad);
  background: var(--status-bad-bg);
  color: var(--status-bad);
}

.banner p {
  margin: var(--space-1) 0 0;
  color: var(--text-primary);
}

.warnings-list {
  margin: var(--space-2) 0 0;
  padding-left: var(--space-6);
  color: var(--text-muted);
}

.label {
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  line-height: 14px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.badge {
  display: inline-block;
  padding: 2px 6px;
  border-radius: 2px;
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  line-height: 14px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-weight: 500;
}

.badge-ok {
  border: 1px solid var(--status-ok);
  background: var(--status-ok-bg);
  color: var(--status-ok);
}

.badge-bad {
  border: 1px solid var(--status-bad);
  background: var(--status-bad-bg);
  color: var(--status-bad);
}

.badge-busy {
  border: 1px solid var(--status-busy);
  background: var(--status-busy-bg);
  color: var(--status-busy);
}

.badge-warn {
  border: 1px solid var(--status-warn);
  background: var(--status-warn-bg);
  color: var(--status-warn);
}

.badge-muted {
  border: none;
  background: var(--bg-elev-2);
  color: var(--text-faint);
}

.funnel {
  margin: var(--space-6) 0;
}

.funnel-bars {
  display: flex;
  align-items: stretch;
  gap: 1px;
  height: 14px;
  background: var(--bg-elev-2);
  border: 1px solid var(--border);
}

.funnel-segment {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: 2px;
  background: var(--text-primary);
  padding: 0 var(--space-1);
  overflow: hidden;
}

.funnel-segment-label {
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  line-height: 14px;
  color: var(--bg);
  white-space: nowrap;
}

.funnel-legend {
  margin: var(--space-2) 0 0;
  padding: 0;
  list-style: none;
}

.funnel-legend li {
  margin: var(--space-1) 0;
  font-size: 13px;
  line-height: 18px;
  color: var(--text-muted);
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.empty-state {
  margin: var(--space-4) 0;
  padding: var(--space-4);
  border: 1px solid var(--border);
  background: var(--bg-elev-1);
}

.empty-state ul {
  margin: var(--space-2) 0;
  padding-left: var(--space-6);
}

.empty-state .hint {
  margin-top: var(--space-3);
  color: var(--text-muted);
  font-size: 13px;
}

.prospect-card {
  margin: var(--space-2) 0;
  border: 1px solid var(--border);
  background: var(--bg);
}

.prospect-card[open] {
  margin: var(--space-4) 0;
}

.prospect-card > summary {
  list-style: disclosure-closed;
  cursor: pointer;
  padding: var(--space-3) var(--space-4);
  background: var(--bg-elev-2);
  font-weight: 500;
}

.prospect-card[open] > summary {
  list-style: disclosure-open;
}

.card-header-row {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--space-2);
}

.card-title {
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
}

.card-subtitle {
  color: var(--text-muted);
  font-size: 13px;
  line-height: 18px;
}

.card-slug-muted {
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  line-height: 14px;
  color: var(--text-faint);
}

.run-summary {
  margin: 0 0 var(--space-6);
  padding: var(--space-3) var(--space-4);
  border: 1px solid var(--border);
  background: var(--bg-elev-1);
  font-size: 14px;
  line-height: 20px;
}

.run-summary-action {
  margin: var(--space-2) 0 0;
  color: var(--text-muted);
  font-size: 13px;
}

.run-summary a {
  color: var(--status-busy);
  font-weight: 600;
}

.card-slug {
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 13px;
}

.slug-link {
  margin-left: var(--space-1);
  padding: 0 var(--space-1);
  border: none;
  background: transparent;
  color: var(--text-muted);
  font-size: 11px;
  cursor: pointer;
  text-decoration: none;
}

.slug-link:hover {
  color: var(--text-primary);
}

.slug-link:focus,
a:focus {
  outline: 2px solid var(--status-busy);
  outline-offset: 1px;
}

.card-meta-inline {
  color: var(--text-muted);
  font-size: 13px;
}

.card-body {
  padding: var(--space-4);
}

.card-section {
  margin-bottom: var(--space-6);
}

.card-section:last-child {
  margin-bottom: 0;
}

.message-block {
  margin: var(--space-2) 0 0;
  padding: var(--space-3);
  border: 1px solid var(--border);
  background: var(--bg-elev-1);
  white-space: pre-wrap;
  word-break: break-word;
}

.message-meta {
  margin: 0 0 var(--space-2);
  font-size: 13px;
  color: var(--text-muted);
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  align-items: center;
}

.btn-copy {
  padding: var(--space-1) var(--space-3);
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--text-primary);
  font: inherit;
  font-size: 13px;
  cursor: pointer;
}

.btn-copy.btn-primary {
  border-color: var(--status-ok);
  background: var(--status-ok-bg);
  color: var(--status-ok);
  font-weight: 600;
}

.btn-link {
  display: inline-block;
  padding: var(--space-1) var(--space-3);
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--text-primary);
  font-size: 13px;
  text-decoration: none;
}

.btn-link:hover {
  background: var(--bg-elev-1);
}

.btn-copy:hover {
  background: var(--bg-elev-1);
}

.btn-copy:focus {
  outline: 2px solid var(--status-busy);
  outline-offset: 1px;
}

.btn-copy.is-copied {
  background: var(--status-ok-bg);
  color: var(--status-ok);
}

.btn-copy.is-persisted::after {
  content: " ✓ sent";
  font-size: 11px;
}

.cta-text {
  margin: var(--space-2) 0 0;
  font-size: 13px;
  color: var(--text-muted);
}

.profile-line {
  margin: var(--space-1) 0 0;
}

table {
  width: 100%;
  border-collapse: collapse;
  border: 1px solid var(--border-strong);
  box-shadow: 0 1px 0 rgb(0 0 0 / 0.08);
}

th,
td {
  padding: var(--space-2) var(--space-3);
  border: 1px solid var(--border);
  text-align: left;
  vertical-align: top;
}

th {
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--text-muted);
  background: var(--bg-elev-2);
}

td.num {
  text-align: right;
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
}

table.zebra tbody tr:nth-child(even) {
  background: var(--bg-elev-1);
}

.verification-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  font-size: 13px;
}

.check-ok {
  color: var(--status-ok);
}

.check-bad {
  color: var(--status-bad);
}

.nested-details {
  margin: var(--space-2) 0;
  border: 1px solid var(--border);
}

.nested-details > summary {
  padding: var(--space-2) var(--space-3);
  background: var(--bg-elev-2);
  cursor: pointer;
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--text-muted);
  list-style: disclosure-closed;
}

.nested-details[open] > summary {
  list-style: disclosure-open;
}

.nested-details .nested-body {
  padding: var(--space-3);
}

.trace-block {
  margin: var(--space-2) 0;
}

.trace-block pre {
  margin: var(--space-1) 0 0;
  padding: var(--space-3);
  background: var(--code-bg);
  border: 1px solid var(--border);
  overflow-x: auto;
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 13px;
  line-height: 18px;
  white-space: pre-wrap;
  word-break: break-word;
}

.round-diff pre {
  margin: 0;
  padding: var(--space-2);
  background: var(--code-bg);
  border: 1px solid var(--border);
  overflow-x: auto;
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 13px;
  line-height: 18px;
  white-space: pre-wrap;
  word-break: break-word;
}

.round-diff .diff-line {
  display: block;
  padding: 0 var(--space-2);
}

.round-diff .diff-add {
  background: var(--status-ok-bg);
}

.round-diff .diff-del {
  background: var(--status-bad-bg);
}

.round-diff .diff-chg {
  background: var(--status-warn-bg);
}

.round-diff .diff-ctx {
  background: var(--bg);
}

.round-diff table {
  font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 13px;
  line-height: 18px;
  box-shadow: none;
}

.round-diff .diff_add {
  background: var(--status-ok-bg);
}

.round-diff .diff_chg {
  background: var(--status-warn-bg);
}

.round-diff .diff_sub {
  background: var(--status-bad-bg);
}

footer {
  margin-top: var(--space-12);
  padding-top: var(--space-4);
  border-top: 1px solid var(--border);
  color: var(--text-muted);
  font-size: 13px;
}

@media print {
  details,
  .prospect-card,
  .nested-details {
    display: block;
  }

  .prospect-card > summary,
  .nested-details > summary {
    display: none;
  }

  .prospect-card .card-body,
  .nested-details .nested-body {
    display: block;
  }

  .btn-copy,
  .slug-link {
    display: none !important;
  }

  .prospect-card {
    break-inside: avoid;
    page-break-inside: avoid;
  }
}
</style>
